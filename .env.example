# Copy this file to .env for local development (never commit .env).
# On Netlify / Vercel set the same two variables in the project's
# "Environment variables" settings instead.

# Supabase → Project Settings → API (Data API) → Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API Keys → the PUBLIC key:
#   "anon public" (legacy, starts with eyJ...) or "publishable" (starts with sb_publishable_)
# NEVER put the service_role / secret key here. The build refuses it.
SUPABASE_ANON_KEY=
